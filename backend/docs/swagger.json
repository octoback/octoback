{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "OctoBackup 的认证与用户管理 API。",
        "title": "OctoBackup API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/audit/page": {
            "post": {
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "description": "查询当前系统中的用户写操作和认证结果审计记录。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "审计"
                ],
                "summary": "查询审计日志",
                "parameters": [
                    {
                        "description": "分页和筛选条件",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/audit.AuditLogPageQuery"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/audit.AuditLogPageResult"
                        }
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "description": "登录成功后返回有效期默认 7 天的 JWT Bearer token。",
